          "type": "datadog_monitor",
          "name": "cpu_monitor",
          "provider_name": "registry.terraform.io/datadog/datadog",
          "values": {
            "name": "High CPU Usage Alert",
            "type": "metric alert",
            "query": "avg(last_5m):avg:system.cpu.user{*} by {host} > 90",
            "message": "CPU usage is above 90% on {{host.name}}",
